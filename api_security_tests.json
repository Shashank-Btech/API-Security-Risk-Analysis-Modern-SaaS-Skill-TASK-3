{
  "info": {
    "name": "API Security Risk Analysis Tests",
    "description": "Collection of API security tests for the API Security Risk Analysis project. Import into Postman or Insomnia to run manually.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "1.0.0"
  },
  "item": [
    {
      "name": "1. Authentication Tests",
      "item": [
        {
          "name": "1.1 Access Users Without Auth (JSONPlaceholder)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users"]
            },
            "description": "TEST: Access user data without authentication.\nEXPECTED: Should return 401 Unauthorized.\nFINDING: Returns 200 with full user data (email, phone, address)."
          }
        },
        {
          "name": "1.2 Access Users Without Auth (DummyJSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/users",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["users"]
            },
            "description": "TEST: Access user data without authentication.\nFINDING: Returns sensitive PII without auth."
          }
        },
        {
          "name": "1.3 Invalid Bearer Token (DummyJSON)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer INVALID_TOKEN_12345"
              }
            ],
            "url": {
              "raw": "https://dummyjson.com/auth/me",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "me"]
            },
            "description": "TEST: Access protected endpoint with invalid token.\nEXPECTED: Should return 401.\nCHECK: Does it reject the invalid token properly?"
          }
        },
        {
          "name": "1.4 Empty Authorization Header",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": ""
              }
            ],
            "url": {
              "raw": "https://dummyjson.com/auth/me",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "me"]
            },
            "description": "TEST: Send empty Authorization header.\nEXPECTED: Should return 401."
          }
        },
        {
          "name": "1.5 Login with Valid Creds (DummyJSON)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"username\": \"emilys\", \"password\": \"emilyspass\"}"
            },
            "url": {
              "raw": "https://dummyjson.com/auth/login",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["auth", "login"]
            },
            "description": "TEST: Login with valid credentials.\nCHECK: What data is returned? Is it excessive?"
          }
        }
      ]
    },
    {
      "name": "2. IDOR Tests",
      "item": [
        {
          "name": "2.1 Enumerate User ID 1",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users/1",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users", "1"]
            },
            "description": "TEST: Access user by ID.\nCHECK: Can we access any user by changing the ID?"
          }
        },
        {
          "name": "2.2 Enumerate User ID 5",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users/5",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users", "5"]
            },
            "description": "TEST: Access different user by ID.\nFINDING: Sequential IDs allow enumeration."
          }
        },
        {
          "name": "2.3 Enumerate DummyJSON User",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/users/3",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["users", "3"]
            },
            "description": "TEST: Access DummyJSON user by ID.\nFINDING: Returns full PII for any user ID."
          }
        }
      ]
    },
    {
      "name": "3. Input Validation Tests",
      "item": [
        {
          "name": "3.1 SQL Injection in POST",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"' OR '1'='1\", \"body\": \"test\", \"userId\": 1}"
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["posts"]
            },
            "description": "TEST: Send SQL injection payload in POST body.\nEXPECTED: Should reject or sanitize.\nCHECK: Is the payload stored as-is?"
          }
        },
        {
          "name": "3.2 XSS in POST Body",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"<script>alert('xss')</script>\", \"body\": \"test\", \"userId\": 1}"
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["posts"]
            },
            "description": "TEST: Send XSS payload in POST body.\nCHECK: Is the script tag reflected unencoded?"
          }
        },
        {
          "name": "3.3 Oversized Payload",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\", \"body\": \"BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\"}"
            },
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/posts",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["posts"]
            },
            "description": "TEST: Send oversized payload.\nEXPECTED: Should return 413 or reject.\nCHECK: Does the API enforce size limits?"
          }
        }
      ]
    },
    {
      "name": "4. Security Headers Check",
      "item": [
        {
          "name": "4.1 Check JSONPlaceholder Headers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users"]
            },
            "description": "CHECK RESPONSE HEADERS FOR:\n- Strict-Transport-Security\n- Content-Security-Policy\n- X-Content-Type-Options\n- X-Frame-Options\n- Access-Control-Allow-Origin (should NOT be *)"
          }
        },
        {
          "name": "4.2 Check DummyJSON Headers",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/products",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["products"]
            },
            "description": "CHECK RESPONSE HEADERS FOR:\n- Security headers presence\n- Server/X-Powered-By disclosure\n- CORS configuration"
          }
        }
      ]
    },
    {
      "name": "5. Data Exposure Tests",
      "item": [
        {
          "name": "5.1 Full User Data (JSONPlaceholder)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://jsonplaceholder.typicode.com/users",
              "protocol": "https",
              "host": ["jsonplaceholder", "typicode", "com"],
              "path": ["users"]
            },
            "description": "CHECK: Does the response contain sensitive fields?\nLook for: email, phone, address, website\nFINDING: All PII exposed without auth."
          }
        },
        {
          "name": "5.2 User PII (DummyJSON)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "https://dummyjson.com/users/1",
              "protocol": "https",
              "host": ["dummyjson", "com"],
              "path": ["users", "1"]
            },
            "description": "CHECK: Full user profile with PII.\nLook for: email, phone, birthDate, address, bank info\nFINDING: Extensive PII exposed without auth."
          }
        }
      ]
    }
  ]
}

